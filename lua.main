scrollFrame:FindFirstChild("BillboardGui").MouseButton1Click:Connect(function() local Players = game:GetService("Players") local LocalPlayer = Players.LocalPlayer local function applyBillboard(character) local head = character:WaitForChild("Head", 10) if not head or head:FindFirstChild("SpookyBillboard") then return end local bbg = Instance.new("BillboardGui") bbg.Name = "SpookyBillboard" bbg.Size = UDim2.new(0, 200, 0, 50) bbg.StudsOffset = Vector3.new(0, 2.5, 0) bbg.AlwaysOnTop = true bbg.Parent = head local tl = Instance.new("TextLabel") tl.Size = UDim2.new(1, 0, 1, 0) tl.Text = "2sp00ky4m3" tl.TextColor3 = Color3.fromRGB(255, 102, 0) tl.BackgroundTransparency = 1 tl.TextSize = 45 tl.Font = Enum.Font.SourceSansBold tl.Parent = bbg end if LocalPlayer.Character then applyBillboard(LocalPlayer.Character) end LocalPlayer.CharacterAdded:Connect(applyBillboard) end)
