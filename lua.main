scrollFrame:FindFirstChild("Stop Sounds").MouseButton1Click:Connect(function() for _, sound in ipairs(game:GetDescendants()) do if sound:IsA("Sound") then sound:Stop() end end end)
scrollFrame:FindFirstChild("Distort").MouseButton1Click:Connect(function() local Workspace = game:GetService("Workspace") local function applyDistortion(sound) if not sound:IsA("Sound") then return end local distort = Instance.new("DistortionSoundEffect") distort.Parent = sound end for _, v in ipairs(Workspace:GetDescendants()) do applyDistortion(v) end end)
scrollFrame:FindFirstChild("Reverb").MouseButton1Click:Connect(function() local Workspace = game:GetService("Workspace") local function applyReverb(sound) if not sound:IsA("Sound") then return end local reverb = Instance.new("ReverbSoundEffect") reverb.Parent = sound end for _, v in ipairs(Workspace:GetDescendants()) do applyReverb(v) end end)
