local function createButton(name)
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.Text = name
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = 15
	btn.Font = Enum.Font.SourceSans
	btn.TextWrapped = true
	btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	btn.BorderColor3 = Color3.fromRGB(255, 69, 0)
	btn.BorderSizePixel = 2
	btn.Parent = scrollFrame

	btn.MouseButton1Click:Connect(function()
		btn.BackgroundColor3 = Color3.fromRGB(255, 69, 0)
		btn.TextColor3 = Color3.fromRGB(0, 0, 0)
		task.wait(0.1)
		btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	end)
end

for _, name in ipairs(adminButtons) do createButton(name) end
for _, name in ipairs(musicButtons) do createButton(name) end

